<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Primary crafting recipe (explicit, not auto-generated from costList/recipeMaker).
    Gated behind the Anomaly DLC: a shard is the thematic seed for a reactor that
    "draws sustenance from the echoes of violent death".

    Why explicit: the parent ThingDef suppresses recipeMaker (see the ThingDef
    comment) and we hand-write the recipe. Unlike the salvage recipe below, every
    ingredient here is a plain stackable resource, so this one does NOT need
    allowMixingIngredients (the NoMix def-level ingredient search resolves them).

    Cost check: Shard 400 + ComponentSpacer 200 + Plasteel 10x9=90 = ~690 of
    inputs for a part with an explicit MarketValue of 650 - roughly break-even.
  -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>AAH_MakeThanaticReactor</defName>
    <label>make thanatic reactor</label>
    <description>Make a thanatic reactor around a shard, binding its death-resonance into an android reactor core.</description>
    <jobString>Making thanatic reactor.</jobString>
    <workAmount>26000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <unfinishedThingDef>VREA_UnfinishedHealthItemAndroid</unfinishedThingDef>
    <researchPrerequisite>AAH_ArchotechAndroidtech</researchPrerequisite>
    <recipeUsers>
      <li>VREA_AndroidPartWorkbench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Shard</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Shard</li>
        <li>ComponentSpacer</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <AAH_ThanaticReactor>1</AAH_ThanaticReactor>
    </products>
  </RecipeDef>

  <!--
    Salvage recipe (Vanilla Power Expanded only): break down an Archotech Violence
    Generator into reactor cores rather than crafting one from scratch. Framed as
    salvage, not construction - you recover the generator's archotech violence core
    as three thanatic reactors plus the steel you'd get from deconstructing it.

    MayRequire on the RecipeDef: skipped when VPE is absent (the generator doesn't
    exist), but the hediff, ThingDef, surgery, and the Shard recipe above remain
    functional.

    allowMixingIngredients: the AllowMix path calls ThingFilter.Allows(Thing) which
    unwraps minified buildings (the generator is a minified building); the NoMix
    path only does def-level matching and would never find it. See the comment in
    RecipeDefs_VanometricReactor.xml for the deeper rationale.

    Balance (measured against the only realistic baseline - just deconstructing the
    generator, which returns ~275 steel + 9 spacer components ~= 2,320 of materials):
    salvaging instead spends +30 plasteel (270) and the work, forgoes those 9 spacer
    components (1,800), and yields 3 reactors + the same 275 steel. That is ~2,070 of
    inputs for 3 reactors, i.e. ~690 each against the 650 part value - near-fair, and
    the 3x output makes tearing down a 3,400 building feel like salvage, not waste.

    No researchPrerequisite (deliberately, unlike the from-scratch recipe above): the
    Steel byproduct would otherwise show up as "Steel" under AAH_ArchotechAndroidtech's
    research unlocks, which is misleading and silly. Gating is left to needing the
    generator itself, plus the android workbench. Do NOT re-add a researchPrerequisite
    here for parity with the primary recipe.
  -->
  <RecipeDef MayRequire="VanillaExpanded.VFEPower">
    <defName>AAH_SalvageThanaticReactor</defName>
    <label>salvage thanatic reactors</label>
    <description>Salvage an archotech violence generator into three thanatic reactor cores, recovering its steel in the process.</description>
    <jobString>Salvaging thanatic reactors.</jobString>
    <allowMixingIngredients>true</allowMixingIngredients>
    <!-- Low work on purpose: deconstructing the generator costs ~3000 ticks
         (JobDriver_Deconstruct clamps WorkToBuild to [20, 3000]), so this bench
         salvage is pinned to roughly the same effort (~1.2 in-game hours) rather
         than a full from-scratch craft (26000) - otherwise nobody would use it
         over deconstructing. -->
    <workAmount>3000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <unfinishedThingDef>VREA_UnfinishedHealthItemAndroid</unfinishedThingDef>
    <recipeUsers>
      <li>VREA_AndroidPartWorkbench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>VPE_ArchotechViolenceGenerator</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>VPE_ArchotechViolenceGenerator</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <AAH_ThanaticReactor>3</AAH_ThanaticReactor>
      <Steel>275</Steel>
    </products>
    <!-- Multi-output recipe: RecipeDef.ProducedThingDef returns null unless there's
         exactly one product, so the bill icon would otherwise be blank. Pin it to the
         headline output (the reactor, not the salvaged steel). -->
    <uiIconThing>AAH_ThanaticReactor</uiIconThing>
  </RecipeDef>

  <!--
    Surgery installation recipe. Targets the Stomach body part (android reactor slot),
    matching AAH_InstallVanometricReactor and VREA's native reactor install.

    No standalone removal recipe (mirrors Vanometric Reactor): transferability between
    androids is achieved via replacement surgery — installing a new reactor ejects the
    old one with its current energy preserved, via Hediff_ThanaticReactor.EjectCustom
    dispatched through AAHPartEjector.

    The install flow writes the ingredient item's storedEnergy onto the freshly-added
    Hediff_ThanaticReactor — see ThanaticReactorInstallEnergyTransfer patch.
  -->
  <RecipeDef ParentName="VREA_SurgeryInstallBodyPartAndroidBase">
    <defName>AAH_InstallThanaticReactor</defName>
    <label>install thanatic reactor</label>
    <description>Install a thanatic reactor, replacing the android's existing reactor. Fed by humanlike kills; the android dies when the charge runs out.</description>
    <descriptionHyperlinks>
      <ThingDef>AAH_ThanaticReactor</ThingDef>
      <HediffDef>AAH_ThanaticReactor</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing thanatic reactor.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>AAH_ThanaticReactor</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AAH_ThanaticReactor</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Stomach</li>
    </appliedOnFixedBodyParts>
    <addsHediff>AAH_ThanaticReactor</addsHediff>
    <uiIconThing>AAH_ThanaticReactor</uiIconThing>
  </RecipeDef>

</Defs>