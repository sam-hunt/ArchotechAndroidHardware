<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Vanometric reactor hediff. Installed on the Stomach body part (android reactor slot).

    Power suppression uses two complementary mechanisms:
    1. Companion gene (AAH_VanometricReactor GeneDef) overrides VREA_Power via Biotech's
       exclusion tag system, preventing VREA_Power's enablesNeeds from creating the need.
    2. disablesNeeds below removes any residual VREA_ReactorPower need instance.
       Uses the same built-in mechanism as the Circadian Half-cycler (Royalty DLC).
       Cache-based via HediffSet.CacheNeeds(), zero per-tick cost.

    hediffClass: Hediff_VanometricReactor manages the companion gene lifecycle
    (add on install, remove on uninstall, restore on load if missing).

    spawnThingOnRemoved: Returns the item on surgical removal. NOTE: VREA's
    RestorePart does NOT honor this field (see RecipeInstallAndroidPart patch).

    Parent: VREA_AndroidBodyPartBase provides isBad:false, blue label color, and
    countsAsAddedPartOrImplant for the android body part category.
  -->
  <HediffDef ParentName="VREA_AndroidBodyPartBase">
    <defName>AAH_VanometricReactor</defName>
    <label>vanometric reactor</label>
    <labelNoun>a vanometric reactor</labelNoun>
    <description>An installed vanometric reactor. This archotech-powered reactor provides unlimited energy, eliminating the need for reactor replacement.</description>
    <descriptionHyperlinks>
      <ThingDef>AAH_VanometricReactor</ThingDef>
    </descriptionHyperlinks>
    <hediffClass>ArchotechAndroidHardware.Hediff_VanometricReactor</hediffClass>
    <spawnThingOnRemoved>AAH_VanometricReactor</spawnThingOnRemoved>
    <stages>
      <li>
        <disablesNeeds>
          <li>VREA_ReactorPower</li>
        </disablesNeeds>
      </li>
    </stages>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
    <!--
      Chest overlay (single render node — the reactor chassis sprite). The
      emissive core glow is supplied at runtime by ReactorGlowMote.Maintain
      via Mote_AAHReactorGlow at AltitudeLayer.Darkness, which renders above
      the unnatural-darkness section layer so the glow pierces it (noctol-
      eyes pattern). Keeping the glow in a separate mote (rather than as a
      second FireGlow render node here) is what enables the darkness pierce
      — render nodes draw at the pawn altitude band and are occluded.

      baseLayer 35 sits between apparel root (20) and firefoam (40), so the
      overlay draws over apparel. visibleFacing=South only; the chassis is
      centred on the chest and would be obscured by the pawn in the other
      three facings. ReactorGlowMote applies south-only parity in code so
      the glow mote matches.
    -->
    <renderNodeProperties>
      <li>
        <workerClass>ArchotechAndroidHardware.PawnRenderNodeWorker_ReactorAttachment</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/AAH_VanometricReactor_Chest</texPath>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>35</baseLayer>
        <drawSize>0.2</drawSize>
        <visibleFacing>
          <li>South</li>
        </visibleFacing>
        <rotDrawMode>Fresh</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <offset>(0, 0, 0)</offset>
          </defaultData>
        </drawData>
      </li>
      <!-- Core glow node (drawn with the chassis whenever this reactor's body
           attachment is enabled, via PawnRenderNodeWorker_ReactorGlow).
           Sibling of the chest attachment above; baseLayer 36 draws the additive
           halo just over the chest core. drawSize 0.4 = chest 0.2 × the 256/128
           glow-vs-chest canvas ratio, confirmed by eye against the chest core. Z
           offset -0.01 seats the halo onto the chest core (the chest sprite
           renders slightly south of the body's root). Colour mirrors GlowTint in
           Hediff_VanometricReactor (lime 0.871,0.875,0.259) — keep in sync. When
           the reactorGlowMoteOverlay setting is on, ReactorGlowMote layers an
           additional darkness-piercing glow on top of this node. -->
      <li>
        <workerClass>ArchotechAndroidHardware.PawnRenderNodeWorker_ReactorGlow</workerClass>
        <texPath>Things/Mote/AAHReactorGlow</texPath>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>36</baseLayer>
        <drawSize>0.4</drawSize>
        <color>(0.871, 0.875, 0.259, 1)</color>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <visibleFacing>
          <li>South</li>
        </visibleFacing>
        <rotDrawMode>Fresh</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <offset>(0, 0, -0.01)</offset>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

</Defs>