<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Grav reactor hediff. Installed on the Stomach body part (android reactor slot).
    Fully Odyssey-gated — without Odyssey there is no refill mechanism, so the
    hediff shouldn't load (no orphaned-install risk).

    Behaviour mirrors Thanatic in shape:
      - Keeps VREA's power need visible (no disablesNeeds; the need bar must be
        visible because depletion is the whole point).
      - Energy stored on the Hediff (curEnergy), exposed via the
        IAAHReactorEnergy interface so NeedReactorPower_CurLevel can pipe the
        value into VREA's need bar.
      - Drain rate driven entirely by the companion gene's biostatMet feeding
        VREA's PowerEfficiencyToPowerDrainFactorCurve. Companion gene has
        biostatMet 0 (baseline drain) — gravship launches are infrequent
        events, so faster-than-baseline drain would make this unplayable.

    On depletion: severity is driven to 1 via TickInterval setting
    Severity = 1 - Energy. The empty stage's Consciousness setMax of 0 makes
    CanBeAwake false, which the PawnHealthTracker_ShouldBeDowned postfix then
    reads as "force downed" via its capacity-based check. The pawn does NOT
    die — unlike Thanatic, an empty grav reactor leaves the host inert but
    revivable by reinstalling a charged unit.

    Companion gene lifecycle (add on install, remove on uninstall, re-assert on
    post-load-init) handled in Hediff_GravReactor, same pattern as Vanometric
    and Thanatic.

    Parent: VREA_AndroidBodyPartBase — isBad:false, blue label colour,
    countsAsAddedPartOrImplant.
  -->
  <HediffDef ParentName="VREA_AndroidBodyPartBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>AAH_GravReactor</defName>
    <label>grav reactor</label>
    <labelNoun>a grav reactor</labelNoun>
    <description>An installed grav reactor. Draws power from gravitational waves and is recharged in full whenever its host participates in a gravship launch ritual.</description>
    <descriptionHyperlinks>
      <ThingDef>AAH_GravReactor</ThingDef>
    </descriptionHyperlinks>
    <hediffClass>ArchotechAndroidHardware.Hediff_GravReactor</hediffClass>
    <initialSeverity>0</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <!-- Charge present: no caps modified. The hediff label suppresses the
           stage label so the UI just shows "grav reactor", not "grav reactor
           (charged)" / "(empty)". -->
      <li>
        <minSeverity>0</minSeverity>
      </li>
      <!-- Energy at zero (Severity ≥ 1): setMax 0 on Consciousness makes
           CanBeAwake false → PawnHealthTracker_ShouldBeDowned's postfix
           re-evaluates capacity-based and flips __result to true (downed).
           The pawn remains alive — a replacement reactor or recharge would
           restore them. -->
      <li>
        <minSeverity>1</minSeverity>
        <label>depleted</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
    <!-- Chest overlay — see HediffDefs_VanometricReactor.xml for the layering
         rationale. The emissive core glow lives in Mote_AAHReactorGlow,
         maintained by ReactorGlowMote.Maintain from Hediff_GravReactor.
         Cyan-blue tint (0, 0.714, 0.937) matches the chest core's RGB
         (0, 182, 239) exactly, applied in code via Mote.instanceColor. -->
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/AAH_GravReactor_Chest</texPath>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>35</baseLayer>
        <drawSize>0.2</drawSize>
        <visibleFacing>
          <li>South</li>
        </visibleFacing>
        <rotDrawMode>Fresh</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <offset>(0, 0, 0)</offset>
          </defaultData>
        </drawData>
      </li>
      <!-- Core glow node (RenderNodeSafe mode only) — see
           HediffDefs_VanometricReactor.xml for the drawSize / offset rationale.
           Colour mirrors GlowTint in Hediff_GravReactor
           (cyan 0,0.714,0.937) — keep in sync. -->
      <li>
        <workerClass>ArchotechAndroidHardware.PawnRenderNodeWorker_ReactorGlow</workerClass>
        <texPath>Things/Mote/AAHReactorGlow</texPath>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>36</baseLayer>
        <drawSize>0.4</drawSize>
        <color>(0, 0.714, 0.937, 1)</color>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <visibleFacing>
          <li>South</li>
        </visibleFacing>
        <rotDrawMode>Fresh</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <offset>(0, 0, -0.01)</offset>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

</Defs>