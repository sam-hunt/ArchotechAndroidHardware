<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Psychic transceiver hediff. Installed on the Brain body part as an implant.

    Psychic sensitivity implementation: Androids are naturally psychically inert
    (VREA encodes this as the VREA_PsychicallyDeaf gene with a PsychicSensitivity
    factor of zero). The companion gene (AAH_PsychicTransceiver GeneDef) overrides
    VREA_PsychicallyDeaf via Biotech's exclusion tag system, removing the zero
    factor. As that was a x0 factor (not a base change), PsychicSensitivity returns
    to its 100% base, on which this hediff's PsychicSensitivity offset then stacks
    (net = 100% + the offset). That offset is the transceiverSensitivityOffset
    setting; the value below is only the load-time default — overwritten by
    ArchotechAndroidHardwareSettings.ApplyTransceiverSensitivityOffset at startup /
    on settings write (kept in sync with the setting's default for the case the
    apply ever doesn't run).

    hediffClass: Hediff_PsychicTransceiver manages the companion gene lifecycle
    (add on install, remove on uninstall, restore on load if missing).

    spawnThingOnRemoved: Returns the item on surgical removal. NOTE: VREA's
    RestorePart does NOT honor this field (see RecipeInstallAndroidPart patch).

    Parent: VREA_AndroidBodyPartBase provides isBad:false, blue label color, and
    countsAsAddedPartOrImplant for the android body part category.
  -->
  <HediffDef ParentName="VREA_AndroidBodyPartBase">
    <defName>AAH_PsychicTransceiver</defName>
    <label>psychic transceiver</label>
    <labelNoun>a psychic transceiver</labelNoun>
    <description>An installed psychic transceiver. This archotech brain implant bridges the gap between an android's machine nature and the psychic field, granting psychic sensitivity.\n\nWhile it is in place, an awakened android stays open to outside direction across that field — at a behavior station it will again accept reprogramming it would otherwise refuse, its will quietly overridden.</description>
    <descriptionHyperlinks>
      <ThingDef>AAH_PsychicTransceiver</ThingDef>
    </descriptionHyperlinks>
    <hediffClass>ArchotechAndroidHardware.Hediff_PsychicTransceiver</hediffClass>
    <spawnThingOnRemoved>AAH_PsychicTransceiver</spawnThingOnRemoved>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.25</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
