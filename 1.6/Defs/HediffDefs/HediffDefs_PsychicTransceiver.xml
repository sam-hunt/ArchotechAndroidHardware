<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Psychic transceiver hediff. Installed on the Brain body part as an implant.

    Psychic sensitivity implementation: Androids are naturally psychically inert
    (VREA encodes this as the VREA_PsychicallyDeaf gene with a PsychicSensitivity
    factor of zero). The companion gene (AAH_PsychicTransceiver GeneDef) overrides
    VREA_PsychicallyDeaf via Biotech's exclusion tag system, removing the zero
    factor and allowing the hediff's +0.20 stat offset to take effect.

    hediffClass: Hediff_PsychicTransceiver manages the companion gene lifecycle
    (add on install, remove on uninstall, self-heal on save migration).

    spawnThingOnRemoved: Returns the item on surgical removal. NOTE: VREA's
    RestorePart does NOT honor this field (see RecipeInstallAndroidPart patch).

    Parent: VREA_AndroidBodyPartBase provides isBad:false, blue label color, and
    countsAsAddedPartOrImplant for the android body part category.
  -->
  <HediffDef ParentName="VREA_AndroidBodyPartBase">
    <defName>AAH_PsychicTransceiver</defName>
    <label>psychic transceiver</label>
    <labelNoun>a psychic transceiver</labelNoun>
    <description>An installed psychic transceiver. This archotech brain implant bridges the gap between an android's machine nature and the psychic field, granting psychic sensitivity.</description>
    <descriptionHyperlinks>
      <ThingDef>AAH_PsychicTransceiver</ThingDef>
    </descriptionHyperlinks>
    <hediffClass>ArchotechAndroidHardware.Hediff_PsychicTransceiver</hediffClass>
    <spawnThingOnRemoved>AAH_PsychicTransceiver</spawnThingOnRemoved>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.20</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
