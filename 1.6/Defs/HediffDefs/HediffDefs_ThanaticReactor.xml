<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Thanatic reactor hediff. Installed on the Stomach body part (android reactor slot).

    Unlike AAH_VanometricReactor (which disablesNeeds VREA_ReactorPower to suppress
    the power bar entirely), Thanatic Reactor keeps VREA's power need visible and
    drains it faster than baseline. The power bar UI stays wired via a Harmony
    postfix on Need_ReactorPower.CurLevel (see NeedReactorPower_CurLevel patch),
    which falls through from VREA_Reactor (absent) to this hediff's Energy.

    All runtime behavior lives in Hediff_ThanaticReactor:
      - TickInterval drain (baseline VREA math; acceleration is provided by the
        companion gene's biostatMet -4 feeding VREA's
        PowerEfficiencyToPowerDrainFactorCurve — realised rate depends on
        VREA's curve at that point, not on any constant in our code)
      - Notify_KilledPawn refill + Thanatic Overcharge application + corpse dessication
      - Death-on-zero-energy (ejects the reactor partially recharged)

    Companion gene AAH_ThanaticReactor (same pattern as other AAH parts) is
    added/removed by Hediff_ThanaticReactor. It declares no exclusionTag — the
    power need stays enabled — but its biostatMet -4 is the sole lever driving
    accelerated drain via VREA's efficiency curve. No hardcoded multiplier in our C#.

    No spawnThingOnRemoved: the reactor item spawning is handled by the hediff
    class's ICustomAAHEjection implementation, which preserves the current
    Energy level onto the ejected item (making the reactor transferable).

    Parent: VREA_AndroidBodyPartBase provides isBad:false, blue label color, and
    countsAsAddedPartOrImplant for the android body part category.
  -->
  <HediffDef ParentName="VREA_AndroidBodyPartBase">
    <defName>AAH_ThanaticReactor</defName>
    <label>thanatic reactor</label>
    <labelNoun>a thanatic reactor</labelNoun>
    <description>An installed thanatic reactor. Draws energy from humanlike kills and bleeds overflow into combat-buffing overcharge bursts. Drains faster than a standard reactor, and its host dies rather than merely shutting down when the charge runs out.</description>
    <descriptionHyperlinks>
      <ThingDef>AAH_ThanaticReactor</ThingDef>
    </descriptionHyperlinks>
    <hediffClass>ArchotechAndroidHardware.Hediff_ThanaticReactor</hediffClass>
    <stages>
      <li />
    </stages>
    <addedPartProps>
      <solid>true</solid>
    </addedPartProps>
    <!-- Chest overlay — see HediffDefs_VanometricReactor.xml for the layering /
         glow-texture rationale. Red tint here to match the thanatic / death motif. -->
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/AAH_ThanaticReactor_Chest</texPath>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>35</baseLayer>
        <drawSize>0.2</drawSize>
        <visibleFacing><li>South</li></visibleFacing>
        <rotDrawMode>Fresh</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <offset>(0, 0, 0)</offset>
          </defaultData>
        </drawData>
      </li>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Mote/FireGlow</texPath>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <color>(1, 0.25, 0.2, 1)</color>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>36</baseLayer>
        <drawSize>0.6</drawSize>
        <visibleFacing><li>South</li></visibleFacing>
        <rotDrawMode>Fresh</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <offset>(0, 0, 0)</offset>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <!--
    Thanatic Overcharge: whole-body combat buff applied when a Thanatic Reactor
    kill overflows the reactor's energy meter. Duration via HediffComp_Disappears;
    ticksToDisappear is set programmatically by Hediff_ThanaticOvercharge.ApplyOrExtend
    (the XML default here is just a placeholder — it gets overwritten before the
    hediff ever ticks).

    Psyfocus bump on initial application (+0.25, Royalty-gated) is applied in
    C# when the hediff is first created. Subsequent overflows extend duration
    without a further bump — see Hediff_ThanaticOvercharge for the anti-farming
    rationale.

    Stat profile mirrors vanilla GoJuiceHigh's combat envelope.
  -->
  <HediffDef>
    <defName>AAH_ThanaticOvercharge</defName>
    <label>thanatic overcharge</label>
    <labelNoun>a thanatic overcharge</labelNoun>
    <description>The thanatic reactor is discharging excess energy across the android's motor and sensor buses. Servo response, targeting precision, and receptor tolerances are all sharply elevated until the overcharge dissipates.</description>
    <defaultLabelColor>(0.9, 0.3, 0.3)</defaultLabelColor>
    <hediffClass>ArchotechAndroidHardware.Hediff_ThanaticOvercharge</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.5</MoveSpeed>
          <PainShockThreshold>0.15</PainShockThreshold>
          <MeleeHitChance>10</MeleeHitChance>
          <MeleeDodgeChance>15</MeleeDodgeChance>
          <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>1.2</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <!-- Placeholder: ticksToDisappear is overwritten in ApplyOrExtend. -->
        <disappearsAfterTicks>1</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!--
    Narrative-only hediff used as the battle-log culprit when a Thanatic Reactor
    drains to zero and kills its host. Never actually added to any pawn — we
    construct a floating instance via HediffMaker.MakeHediff and pass it as
    exactCulprit into Pawn.Kill so that BattleLogEntry_StateTransition picks
    a [CULPRITHEDIFF_labelNoun] death template ("thanatic reactor depletion
    caused X to die") rather than the generic "collapsed" fallback.

    No article on labelNoun because "depletion" is a mass noun — "a thanatic
    depletion caused X to die" reads oddly vs. "thanatic depletion caused X
    to die".
  -->
  <HediffDef>
    <defName>AAH_ThanaticDepletionCulprit</defName>
    <label>thanatic reactor depletion</label>
    <labelNoun>thanatic reactor depletion</labelNoun>
    <description>Placeholder hediff: used only to carry a death-cause label into the combat log when a Thanatic Reactor fully depletes.</description>
    <hediffClass>HediffWithComps</hediffClass>
  </HediffDef>

  <!--
    Injury def used as Hediff_MissingPart.lastInjury for the reactor slot after
    the Thanatic Reactor self-ejects on depletion. alwaysUseDestroyedLabel +
    "ejected" overrides Hediff_MissingPart.LabelBase's default
    "destroyed"/"shattered" path for Inside body parts (stomach depth = Inside,
    which otherwise always returns those labels regardless of lastInjury).

    Not given a parent: InjuryBase adds tend/display behavior we don't want
    here — the injury instance itself never sits on the pawn; it only exists
    as a label carrier on the missing-part hediff.
  -->
  <HediffDef>
    <defName>AAH_ReactorEjectionInjury</defName>
    <label>reactor ejection</label>
    <description>Placeholder injury: used only as Hediff_MissingPart.lastInjury so the reactor slot reads "ejected" on the corpse rather than the default "destroyed".</description>
    <hediffClass>Hediff_Injury</hediffClass>
    <injuryProps>
      <painPerSeverity>0</painPerSeverity>
      <bleedRate>0</bleedRate>
      <canMerge>false</canMerge>
      <alwaysUseDestroyedLabel>true</alwaysUseDestroyedLabel>
      <destroyedLabel>ejected</destroyedLabel>
    </injuryProps>
  </HediffDef>

</Defs>
