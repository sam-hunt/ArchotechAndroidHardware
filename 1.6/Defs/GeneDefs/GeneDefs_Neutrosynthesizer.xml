<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Companion gene for the neutrosynthesizer hediff. NOT player-assignable.
    Managed entirely by Hediff_Neutrosynthesizer (added on install, removed on uninstall).

    Purpose: Overrides VREA's neutro synthesis subroutine (VREA_NeutroSynthesis) via
    Biotech's gene exclusion tag system. The shared AAH_AndroidNeutro tag causes Biotech
    to suppress VREA_NeutroSynthesis while this gene is active. With the subroutine
    suppressed, its slow 0.05/day recovery is replaced by the hediff's 0.3/day per kidney.
    The VREA_GenePatches.xml XPath patch adds this exclusion tag to VREA_NeutroSynthesis.

    canGenerateInGeneSet: false prevents this from appearing in xenotype creation.
    biostatArc > 0 is required for the archite gene background (see modExtensions).

    Background rendering: Uses VEF's GeneExtension.backgroundPathArchite instead of
    the standard endogenes/xenogenes background path. VEF's transpiler in
    GeneUIUtility.DrawGene selects this archite background when biostatArc > 0.

    Display: VREA's custom gene inspector only shows genes its Utils.IsAndroidGene
    check recognises. The Utils_IsAndroidGene patch extends that check to all
    AAH_Hardware-category genes, which also relabels biostatMet as "Power
    efficiency" and rolls it into the inspector's Power efficiency total.
  -->
  <GeneDef>
    <defName>AAH_Neutrosynthesizer</defName>
    <label>super neutro synthesis</label>
    <description>Androids with this hardware can actively synthesize non-trivial quantities of neutroamine, restoring lost internal supplies at a greatly accelerated rate.</description>
    <iconPath>UI/Icons/Genes/Hardware/Gene_SuperNeutroSynthesis</iconPath>
    <displayCategory>AAH_Hardware</displayCategory>
    <displayOrderInCategory>7</displayOrderInCategory>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <biostatArc>1</biostatArc>
    <biostatCpx>4</biostatCpx>
    <exclusionTags>
      <li>AAH_AndroidNeutro</li>
    </exclusionTags>
    <modExtensions>
      <li Class="VEF.Genes.GeneExtension">
        <backgroundPathArchite>UI/Icons/Genes/GeneBackground_ArchotechHardware</backgroundPathArchite>
      </li>
    </modExtensions>
  </GeneDef>

</Defs>
