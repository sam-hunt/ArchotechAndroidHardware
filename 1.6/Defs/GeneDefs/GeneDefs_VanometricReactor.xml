<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Companion gene for the vanometric reactor hediff. NOT player-assignable.
    Managed entirely by Hediff_VanometricReactor (added on install, removed on uninstall).

    Purpose: Overrides VREA's Power hardware component (VREA_Power) via Biotech's
    gene exclusion tag system. The shared AAH_AndroidPower tag causes Biotech to
    suppress VREA_Power while this gene is active. With VREA_Power suppressed, its
    enablesNeeds for VREA_ReactorPower doesn't fire, so the android has no power need.
    The VREA_GenePatches.xml XPath patch adds this exclusion tag to VREA_Power.

    canGenerateInGeneSet: false prevents this from appearing in xenotype creation.
    biostatArc > 0 is required for the archite gene background (see modExtensions).

    Background rendering: Uses VEF's GeneExtension.backgroundPathArchite instead of
    the standard endogenes/xenogenes background path. VEF's transpiler in
    GeneUIUtility.DrawGene selects this archite background when biostatArc > 0.

    Display: VREA's custom gene inspector only shows genes its Utils.IsAndroidGene
    check recognises. The Utils_IsAndroidGene patch extends that check to all
    AAH_Hardware-category genes, which also relabels biostatMet as "Power
    efficiency" and rolls it into the inspector's Power efficiency total.

    Locked: declared as VREAndroids.AndroidGeneDef with isCoreComponent=true so VREA's
    behavior-station modify dialog treats it like core hardware — Utils.CanBeRemovedFromAndroid
    returns false, so it can't be removed by clicking in the dialog (as with VREA's own
    reactor/body genes). Removal stays exclusive to our surgery recipes / hediff hooks.
  -->
  <VREAndroids.AndroidGeneDef>
    <defName>AAH_VanometricReactor</defName>
    <label>vanometric reactor</label>
    <description>Androids with this hardware have an adapted archotech reactor that extracts unlimited power from fluctuations in quantum foam. The reactor never needs to be replaced.</description>
    <iconPath>UI/Icons/Genes/Hardware/Gene_VanometricReactor</iconPath>
    <displayCategory>AAH_Hardware</displayCategory>
    <displayOrderInCategory>3</displayOrderInCategory>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <isCoreComponent>true</isCoreComponent>
    <biostatArc>2</biostatArc>
    <biostatCpx>6</biostatCpx>
    <biostatMet>6</biostatMet>
    <exclusionTags>
      <li>AAH_AndroidPower</li>
    </exclusionTags>
    <modExtensions>
      <li Class="VEF.Genes.GeneExtension">
        <backgroundPathArchite>UI/Icons/Genes/GeneBackground_ArchotechHardware</backgroundPathArchite>
      </li>
    </modExtensions>
  </VREAndroids.AndroidGeneDef>

</Defs>
