<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Thanatic reactor body part item. This is the inventory item; the installed
    state is represented by the AAH_ThanaticReactor HediffDef.

    thingClass: ArchotechAndroidHardware.ThanaticReactorThing stores a
    `storedEnergy` float [0,1] that persists across install/eject cycles,
    making the reactor transferable between android pawns without losing
    its current charge.

    Parent: AAH_BodyPartAndroidArchotechBase (see ThingDefs_BodyPartAndroidArchotechBase.xml) —
    but re-overrides graphicData to the dark archotech variant below.
  -->
  <ThingDef ParentName="AAH_BodyPartAndroidArchotechBase">
    <defName>AAH_ThanaticReactor</defName>
    <label>thanatic reactor</label>
    <description>An archotech android reactor built around a core of violence-attuned archotech matter, whether a salvaged shard or the heart of an archotech violence generator. Unlike conventional reactors, it draws sustenance from the echoes of violent death — each humanlike kill its host delivers pours energy back into its cell, and brief overflows bleed into an overcharge state that supercharges combat reflexes.\n\nWithout a steady supply of kills the reactor drains faster than a standard android reactor and its host will expire when it runs dry. In that terminal moment, the reactor strips one final charge from its host's own death before ejecting, intact, to await its next host.</description>
    <descriptionHyperlinks>
      <RecipeDef>AAH_InstallThanaticReactor</RecipeDef>
    </descriptionHyperlinks>
    <thingClass>ArchotechAndroidHardware.ThanaticReactorThing</thingClass>
    <!-- Dark archotech variant (grey + red), overriding the base's green icon. -->
    <graphicData>
      <texPath>Items/AAH_AndroidPart_ArchotechDark</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <!-- costList retained only to satisfy the def validator (an Inherit="False"
         recipeMaker still requires a costList or costStuffCount). It does NOT
         drive price: the explicit MarketValue below short-circuits
         StatWorker_MarketValue's cost-derived calculation. Crafting ingredients
         live in the explicit RecipeDefs (shard or salvage). Same posture as the
         grav reactor. -->
    <costList>
      <Plasteel>10</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <ArchiteCapsule>1</ArchiteCapsule>
    </costList>
    <statBases>
      <Mass>3</Mass>
      <!-- Explicit price, NOT cost-derived. Neither recipe's ingredients
           reflect its worth (the salvage path consumes a ~3,400 violence
           generator for three reactors; the shard path is far cheaper). We
           price it near the vanilla baseline (VREA_Reactor ~474) because it
           is the only reactor with active upkeep (the host must keep scoring
           humanlike kills to recharge) AND a hard death-on-depletion failure
           mode — the others merely down the pawn. Those downsides offset the
           archotech-tier power, so it shouldn't carry an archotech-tier price. -->
      <MarketValue>650</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(220, 40, 40, 0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
