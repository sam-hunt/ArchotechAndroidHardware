<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Red pawn-silhouette aura motes for the Thanatic Reactor kill and death
    sequences. A plain recolour of vanilla Mote_ResurrectAbility — same
    cloud/speckle stack and scroll vectors, just crimson instead of green
    and with finite self-terminating timings (the resurrect ability mote
    is maintenance-driven with solidTime=999999; ours aren't, so drop
    needsMaintenance and set real fade/solid/fade values per derived def).
  -->
  <ThingDef ParentName="MoteBase" Name="AAH_ThanaticAuraBase" Abstract="True">
    <thingClass>ArchotechAndroidHardware.Mote_ThanaticSilhouetteAura</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_PawnBodySilhouette</graphicClass>
      <color>(0.85, 0.12, 0.18, 1.0)</color>
      <shaderType>MoteMultiplyAddScroll</shaderType>
      <texPath>Things/Mote/Transparent</texPath>
      <shaderParameters>
        <_MultiplyTexA>/Things/Mote/Cloudy_B</_MultiplyTexA>
        <_MultiplyTexB>/Things/Mote/Cloudy_C</_MultiplyTexB>
        <_DetailTex>/Things/Mote/Speckles</_DetailTex>
        <_detailIntensity>1.3</_detailIntensity>
        <_texAScale>0.4</_texAScale>
        <_texBScale>0.3</_texBScale>
        <_DetailScale>1.25</_DetailScale>
        <_texAScrollSpeed>(0, 0.15, 0)</_texAScrollSpeed>
        <_texBScrollSpeed>(0.12, 0, 0)</_texBScrollSpeed>
        <_detailScrollSpeed>(0.15, 0.15, 0)</_detailScrollSpeed>
      </shaderParameters>
    </graphicData>
  </ThingDef>

  <!-- 2.0s total: used for the per-kill victim + source auras -->
  <ThingDef ParentName="AAH_ThanaticAuraBase">
    <defName>AAH_ThanaticAura</defName>
    <mote>
      <fadeInTime>0.3</fadeInTime>
      <solidTime>1.4</solidTime>
      <fadeOutTime>0.3</fadeOutTime>
    </mote>
  </ThingDef>

  <!-- 5.0s total: used for the drain-death dramatization on the dying pawn -->
  <ThingDef ParentName="AAH_ThanaticAuraBase">
    <defName>AAH_ThanaticAuraLong</defName>
    <mote>
      <fadeInTime>0.6</fadeInTime>
      <solidTime>3.8</solidTime>
      <fadeOutTime>0.6</fadeOutTime>
    </mote>
  </ThingDef>

  <!--
    Red homing spark that streams from the victim toward the source android.
    Spawned in batches by ThanaticStreamController; the class-side Tick
    recomputes steering each tick, so particles track the android even
    while it moves. Lifetime is capped by fade+solid+fade (~3.4s) as a
    safety net — in practice the particles self-destruct on target arrival.
  -->
  <ThingDef ParentName="MoteBase">
    <defName>AAH_ThanaticDrainParticle</defName>
    <thingClass>ArchotechAndroidHardware.Mote_ThanaticDrainParticle</thingClass>
    <altitudeLayer>Projectile</altitudeLayer>
    <graphicData>
      <texPath>Things/Mote/SparkThrown</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(1.0, 0.25, 0.28, 1.0)</color>
      <drawSize>0.32</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>3.0</solidTime>
      <fadeOutTime>0.25</fadeOutTime>
    </mote>
  </ThingDef>

  <!--
    Ethereal per-tick emitter. Spawned at the victim's cell by
    Hediff_ThanaticReactor.Notify_KilledPawn; destroys itself after one
    second of emissions. Invisible (no graphicData / drawerType=None via
    EtherealThingBase).
  -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>AAH_ThanaticStreamController</defName>
    <label>thanatic stream controller</label>
    <thingClass>ArchotechAndroidHardware.ThanaticStreamController</thingClass>
    <tickerType>Normal</tickerType>
  </ThingDef>

</Defs>
