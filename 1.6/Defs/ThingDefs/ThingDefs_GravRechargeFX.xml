<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Cyan-blue pawn-silhouette charge aura for the grav reactor. Spawned on
    the host android when a gravship landing refills the reactor — see
    Hediff_GravReactor.Notify_RechargedByLaunch.

    Reuses Mote_ThanaticSilhouetteAura (the class is generic — it just
    carries per-instance scroll-vector overrides for the Pascal-vs-lowercase
    DrawWorker patch). Shader params duplicate AAH_ThanaticAuraBase in
    ThingDefs_ThanaticDeathFX.xml rather than sharing an abstract base:
    keeps the two reactor FX def trees independent for a single extra def.

    Colour matches Hediff_GravReactor.GlowTint exactly (8-bit 0, 182, 239 →
    float 0, 0.714, 0.937). Extra impact on recharge comes from
    _detailIntensity bumped to 1.6 (vs the Thanatic base's 1.3), not from
    the tint — keeps the hue identical to the steady-state core glow, just
    punchier speckle. 15s total runtime (0.6 fade in / 13.8 solid / 0.6
    fade out) — a longer hold than AAH_ThanaticAuraLong's 5s envelope, no
    kill stream to coordinate with, just a self-contained "powering up"
    beat.
  -->
  <ThingDef ParentName="MoteBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>AAH_GravChargeAura</defName>
    <thingClass>ArchotechAndroidHardware.Mote_ThanaticSilhouetteAura</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_PawnBodySilhouette</graphicClass>
      <color>(0, 0.714, 0.937, 1.0)</color>
      <shaderType>MoteMultiplyAddScroll</shaderType>
      <texPath>Things/Mote/Transparent</texPath>
      <shaderParameters>
        <_MultiplyTexA>/Things/Mote/Cloudy_B</_MultiplyTexA>
        <_MultiplyTexB>/Things/Mote/Cloudy_C</_MultiplyTexB>
        <_DetailTex>/Things/Mote/Speckles</_DetailTex>
        <_detailIntensity>1.6</_detailIntensity>
        <_texAScale>0.4</_texAScale>
        <_texBScale>0.3</_texBScale>
        <_DetailScale>1.25</_DetailScale>
        <_texAScrollSpeed>(0, 0.15, 0)</_texAScrollSpeed>
        <_texBScrollSpeed>(0.12, 0, 0)</_texBScrollSpeed>
        <_detailScrollSpeed>(0.15, 0.15, 0)</_detailScrollSpeed>
      </shaderParameters>
    </graphicData>
    <mote>
      <fadeInTime>0.6</fadeInTime>
      <solidTime>13.8</solidTime>
      <fadeOutTime>0.6</fadeOutTime>
    </mote>
  </ThingDef>

</Defs>
