<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Drives every goodwill faction to the -100 floor at game start (see
    ScenPart_AllFactionsHostile). canBeRandomlyAdded=false keeps it out of unrelated
    random scenarios.
  -->
