    <defName>AAH_AllFactionsHostile</defName>
    <label>all factions hostile</label>
    <scenPartClass>ArchotechAndroidHardware.ScenPart_AllFactionsHostile</scenPartClass>
    <category>Rule</category>
    <maxUses>1</maxUses>
    <canBeRandomlyAdded>false</canBeRandomlyAdded>
  </ScenPartDef>

</Defs>
