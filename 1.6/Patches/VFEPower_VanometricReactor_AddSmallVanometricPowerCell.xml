<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Vanilla Furniture Expanded - Power alternative ingredient:
    VFE_SmallVanometricPowerCell can substitute for VanometricPowerCell in
    the vanometric reactor crafting recipe (count 1, either item satisfies
    the slot). Joins the vanilla (VanometricPowerCell) and Royalty
    (UnstablePowerCell, patched separately) options.

    VFE's small vanometric cell is a minifiable building, same as the vanilla
    cell, so the existing allowMixingIngredients=true filter path handles it.

    Gated via PatchOperationFindMod because ThingFilter.ResolveReferences()
    throws on unknown thingDefs if VFE Power is not installed.
  -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Furniture Expanded - Power</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/RecipeDef[defName="AAH_MakeVanometricReactor"]/ingredients/li[filter/thingDefs/li="VanometricPowerCell"]/filter/thingDefs</xpath>
          <value>
            <li>VFE_SmallVanometricPowerCell</li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/RecipeDef[defName="AAH_MakeVanometricReactor"]/fixedIngredientFilter/thingDefs</xpath>
          <value>
            <li>VFE_SmallVanometricPowerCell</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
