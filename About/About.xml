<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Archotech Android Hardware</name>
  <author>Sam Hunt</author>
  <packageId>shunter.archotechandroidhardware</packageId>
  <modVersion>1.0.0</modVersion>
  <description>Adds the vanometric reactor: a self-sustaining android reactor replacement built around an archotech vanometric power cell.

    Unlike the standard android reactor which drains over time and must be replaced, this harnesses the quantum foam energy extraction of a vanometric power cell, miniaturized and adapted to interface directly with android power systems. Once installed, the android's power need is eliminated entirely.
</description>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <modDependencies>
